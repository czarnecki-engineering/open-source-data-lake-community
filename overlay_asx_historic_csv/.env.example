# Optional local overrides for the ASX historic overlay.
# Copy values you need into the repo root .env file before running the overlay.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
JUPYTER_TOKEN=jupyter

# Optional bucket overrides
ASX_RAW_BUCKET=raw
ASX_CONFORMED_BUCKET=conformed
ASX_CURATED_BUCKET=curated
