# Centralized config for BOTH local runtimes (Docker Compose and Kubernetes).
# This is the only file either stack reads credentials/config from.
#
# To use: cp runtime/shared/.env.example runtime/shared/.env
# Then edit runtime/shared/.env (never commit it — it's gitignored).
#
# Compose:     runtime/foundation/compose/start-compose.sh passes this file
#              via `docker compose --env-file`.
# Kubernetes:  runtime/knowledge-lake/start-k8s.sh generates the
#              `shared-credentials` Secret from this file at startup
#              (kubectl create secret generic --from-env-file=...). No
#              credentials are hardcoded in any tracked k8s manifest.
#
# All values below are local-dev-only placeholders, safe to leave as-is.

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FRANKENPHP_PORT=8088
JUPYTER_PORT=8888
JUPYTER_TOKEN=
CLOUDBEAVER_PORT=8978
LAKEKEEPER_PORT=8181
TRINO_PORT=8085
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_PORT=5432
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
LAKEKEEPER_PG_DATABASE_URL_READ=postgresql://airflow:airflow@postgres:5432/airflow
LAKEKEEPER_PG_DATABASE_URL_WRITE=postgresql://airflow:airflow@postgres:5432/airflow
LAKEKEEPER_PG_ENCRYPTION_KEY=lakekeeper-dev-only-encryption-key
AIRFLOW_PORT=8080
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW_FERNET_KEY=8M8vBh1p3P6uI8m7sRj2eY4xTn0Qw5Za
AIRFLOW_WEBSERVER_SECRET_KEY=knowledge-lake-airflow-web-secret
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FIRSTNAME=Knowledge
AIRFLOW_LASTNAME=Lake
AIRFLOW_EMAIL=admin@example.local
AIRFLOW_PIP_ADDITIONAL_REQUIREMENTS=pyiceberg==0.7.1 boto3==1.37.38 pyarrow yfinance
AWS_DEFAULT_REGION=local-01
TZ=Australia/Melbourne
